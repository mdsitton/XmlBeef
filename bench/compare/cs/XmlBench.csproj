<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Exact versions, the newest on 2026-09-30. System.Xml and System.Xml.Linq come with .NET 10. -->
  <ItemGroup>
    <PackageReference Include="TurboXml" Version="[2.1.0]" />
    <!-- KirillOsenkov/XmlParser (Microsoft.Language.Xml) -->
    <PackageReference Include="GuiLabs.Language.Xml" Version="[1.2.120]" />
  </ItemGroup>

</Project>
